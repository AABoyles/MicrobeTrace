{
  "name": "MicrobeTrace",
  "version": "0.7.0",
  "description": "The Visualization Multitool for Molecular Epidemiology and Bioinformatics",
  "homepage": "https://github.com/aaboyles/MicrobeTrace#readme",
  "keywords": [
    "bioinformatics",
    "epidemiology",
    "network-visualization",
    "hiv",
    "pathogens",
    "phylogenetics",
    "phylogenetic-trees",
    "phylogeny",
    "phylogenomics",
    "genomics",
    "genomics-visualization",
    "data-visualization",
    "genomic-data-analysis",
    "sequence-analysis"
  ],
  "author": "Tony Boyles <aaboyles@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaboyles/MicrobeTrace.git"
  },
  "bugs": {
    "url": "https://github.com/aaboyles/MicrobeTrace/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server.js",
    "build": "npm run bundle && npm run cache && npm run compress",
    "bundle": "scripts/bundle.sh",
    "cache": "node scripts/build-sw.js",
    "clean": "scripts/cleanup.sh",
    "site": "node scripts/build-site.js",
    "compress": "scripts/compress.sh",
    "test": "node --test test/unit/*.test.js",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='workers/**' --test-coverage-lines=64 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/unit/*.test.js",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "update": "npm update && npm run bundle && npm run cache"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-http-to-https": "^1.1.4",
    "express-static-gzip": "^3.0.2"
  },
  "devDependencies": {
    "@cosmos.gl/graph": "^3.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "alignment-viewer": "^0.3.4",
    "axe-core": "^4.14.0",
    "bioseq": "^0.1.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cssnano": "^9.6.0",
    "d3": "^7.9.0",
    "d3-polygon": "^3.0.1",
    "d3-symbol-extra": "^0.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "golden-layout": "^2.6.0",
    "gzipper": "^8.3.0",
    "html5sortable": "^0.14.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "papaparse": "^5.7.0",
    "patristic": "^0.6.0",
    "pdfmake": "^0.3.11",
    "plotly.js": "^4.1.2",
    "postcss": "^8.5.29",
    "tabulator-tables": "^6.6.1",
    "tidytree": "^0.7.0",
    "tn93": "^0.3.5",
    "tom-select": "^2.6.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
